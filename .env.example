# ---- Server (packages/server) ----
# Port for HTTP + WebSocket (Socket.IO)
PORT=3001
# Comma-separated allowed origins for the Socket.IO CORS check ("*" if unset)
CORS_ORIGIN=http://localhost:5173
# Directory of the built client to serve (defaults to packages/client/dist)
# STATIC_DIR=/app/packages/client/dist
# Online timing policy (seconds). 0 disables the setup/turn deadline.
SETUP_SECONDS=180
TURN_SECONDS=90
RECONNECT_GRACE_SECONDS=60

# ---- Client (packages/client, read at build time by Vite) ----
# Socket.IO server URL when the client is hosted separately from the server
# VITE_SERVER_URL=https://battleship-api.example.com
# Public base URL encoded into room QR codes / join links (defaults to window.location.origin)
# VITE_PUBLIC_URL=https://battleship.example.com
